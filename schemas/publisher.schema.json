{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civic-source-catalog:publisher:v1",
  "title": "Civic Source Catalog publisher",
  "description": "The government, Tribal government, chapter, special district, or named civic body that publishes or authorizes a collection-level source.",
  "type": "object",
  "required": [
    "publisher_id",
    "publisher_name",
    "publisher_type",
    "country_code",
    "state_codes",
    "county_names",
    "official_website_url"
  ],
  "properties": {
    "publisher_id": {
      "type": "string",
      "pattern": "^us-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Assigned stable key; it is not recomputed from the display name."
    },
    "publisher_name": {
      "type": "string",
      "minLength": 1
    },
    "publisher_type": {
      "type": "string",
      "enum": [
        "municipality",
        "county",
        "tribal_government",
        "tribal_chapter",
        "community_council",
        "special_district",
        "other_public_body"
      ]
    },
    "country_code": {
      "const": "US"
    },
    "state_codes": {
      "$ref": "#/$defs/stateCodes"
    },
    "county_names": {
      "$ref": "#/$defs/countyNames"
    },
    "official_website_url": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "stateCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "AK", "AL", "AR", "AS", "AZ", "CA", "CO", "CT", "DC", "DE",
          "FL", "GA", "GU", "HI", "IA", "ID", "IL", "IN", "KS", "KY",
          "LA", "MA", "MD", "ME", "MI", "MN", "MO", "MP", "MS", "MT",
          "NC", "ND", "NE", "NH", "NJ", "NM", "NV", "NY", "OH", "OK",
          "OR", "PA", "PR", "RI", "SC", "SD", "TN", "TX", "UT", "VA",
          "VI", "VT", "WA", "WI", "WV", "WY"
        ]
      }
    },
    "countyNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Complete known counties or equivalents, sorted; [] is explicit when unknown or inapplicable."
    }
  },
  "additionalProperties": false
}
