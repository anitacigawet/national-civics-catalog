{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civic-source-catalog:place:v1",
  "title": "Civic Source Catalog place",
  "description": "A geography or jurisdiction covered by one or more catalog endpoints.",
  "type": "object",
  "required": [
    "place_id",
    "place_name",
    "place_type",
    "country_code",
    "state_codes",
    "county_names",
    "ocd_division_id",
    "census_geoid"
  ],
  "properties": {
    "place_id": {
      "type": "string",
      "pattern": "^us-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Assigned stable key; it is not recomputed from the display name."
    },
    "place_name": {
      "type": "string",
      "minLength": 1
    },
    "place_type": {
      "type": "string",
      "enum": [
        "municipality",
        "county",
        "tribal_jurisdiction",
        "tribal_chapter",
        "unincorporated_community",
        "special_district",
        "other"
      ]
    },
    "country_code": {
      "const": "US"
    },
    "state_codes": {
      "$ref": "#/$defs/stateCodes"
    },
    "county_names": {
      "$ref": "#/$defs/countyNames"
    },
    "ocd_division_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ocd-division/"
        },
        {
          "type": "null"
        }
      ]
    },
    "census_geoid": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{2,15}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "stateCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "AK", "AL", "AR", "AS", "AZ", "CA", "CO", "CT", "DC", "DE",
          "FL", "GA", "GU", "HI", "IA", "ID", "IL", "IN", "KS", "KY",
          "LA", "MA", "MD", "ME", "MI", "MN", "MO", "MP", "MS", "MT",
          "NC", "ND", "NE", "NH", "NJ", "NM", "NV", "NY", "OH", "OK",
          "OR", "PA", "PR", "RI", "SC", "SD", "TN", "TX", "UT", "VA",
          "VI", "VT", "WA", "WI", "WV", "WY"
        ]
      }
    },
    "countyNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Complete known counties or equivalents, sorted; [] is explicit when unknown or inapplicable."
    }
  },
  "additionalProperties": false
}
