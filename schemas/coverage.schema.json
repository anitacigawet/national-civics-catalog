{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civic-source-catalog:coverage:v1",
  "title": "Civic Source Catalog coverage",
  "description": "A declared relationship between a collection-level endpoint and a covered place.",
  "type": "object",
  "required": [
    "coverage_id",
    "endpoint_id",
    "place_id",
    "coverage_relationship"
  ],
  "properties": {
    "coverage_id": {
      "type": "string",
      "pattern": "^us-[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*--covers--us-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "endpoint_id": {
      "type": "string",
      "pattern": "^us-[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "place_id": {
      "type": "string",
      "pattern": "^us-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "coverage_relationship": {
      "type": "string",
      "enum": [
        "direct_jurisdiction",
        "civic_representation"
      ]
    }
  },
  "additionalProperties": false
}
