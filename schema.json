{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anitacigawet/national-civics-catalog/schema.json",
  "title": "Civic source catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "publisher_name",
    "publisher_type",
    "state_codes",
    "county_names",
    "official_website_url",
    "endpoint_type",
    "url",
    "platform",
    "access_method",
    "source_relationship",
    "status",
    "last_checked",
    "provenance_url",
    "covers"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "publisher_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "publisher_type": {
      "enum": [
        "state",
        "county",
        "municipality",
        "township",
        "school_district",
        "special_district",
        "tribal_government",
        "tribal_chapter",
        "community_council",
        "civic_body",
        "other"
      ]
    },
    "state_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "county_names": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 150 }
    },
    "official_website_url": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^https://" }
      ]
    },
    "endpoint_type": {
      "anyOf": [
        { "type": "null" },
        {
          "enum": [
            "primary_meeting_source",
            "meeting_calendar",
            "agenda_index",
            "minutes_index",
            "public_notices_index",
            "video_archive",
            "api",
            "feed",
            "other"
          ]
        }
      ]
    },
    "url": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^https://", "maxLength": 2048 }
      ]
    },
    "platform": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 100 }
      ]
    },
    "access_method": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["html", "json", "rss", "ical", "api", "pdf_index", "other"] }
      ]
    },
    "source_relationship": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["first_party", "authorized_service"] }
      ]
    },
    "status": {
      "enum": ["needs_source", "working", "empty", "blocked", "broken", "moved", "retired", "unverified"]
    },
    "last_checked": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "date" }
      ]
    },
    "provenance_url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/coveredPlace" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "needs_source" } } },
      "then": {
        "properties": {
          "endpoint_type": { "const": null },
          "url": { "const": null },
          "platform": { "const": null },
          "access_method": { "const": null },
          "source_relationship": { "const": null },
          "last_checked": { "const": null }
        }
      },
      "else": {
        "properties": {
          "endpoint_type": { "type": "string" },
          "url": { "type": "string" },
          "platform": { "type": "string" },
          "access_method": { "type": "string" },
          "source_relationship": { "type": "string" }
        }
      }
    }
  ],
  "$defs": {
    "coveredPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "state_codes",
        "county_names",
        "relationship",
        "ocd_division_id",
        "census_geoid"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": {
          "enum": [
            "state",
            "county",
            "municipality",
            "township",
            "unincorporated_community",
            "school_district",
            "special_district",
            "tribal_jurisdiction",
            "tribal_chapter",
            "other"
          ]
        },
        "state_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
        },
        "county_names": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 150 }
        },
        "relationship": {
          "enum": ["direct_jurisdiction", "governing_parent", "civic_representation", "regional_service"]
        },
        "ocd_division_id": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^ocd-division/" }
          ]
        },
        "census_geoid": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9]{2,15}$" }
          ]
        }
      }
    }
  }
}
